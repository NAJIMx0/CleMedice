<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.UsersController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Gestion des Utilisateurs" styleClass="top-bar-title"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                <TableColumn fx:id="roleCol" text="Role" prefWidth="150"/>
                <TableColumn fx:id="actifCol" text="Actif" prefWidth="80"/>
                <TableColumn text="Actions" prefWidth="250"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Ajouter" onAction="#handleAdd" styleClass="btn-success"/>
            <Button text="Modifier" onAction="#handleEdit" styleClass="btn-primary"/>
            <Button text="Reset Mot de passe" onAction="#handleResetPassword" styleClass="btn-warning"/>
            <Button text="Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
        </HBox>
    </bottom>
</BorderPane>
