<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.ConsultationController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Consultation" styleClass="top-bar-title"/>
            <Label fx:id="patientLabel" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 0 12;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dateLabel" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Description" GridPane.rowIndex="0"/>
                <TextArea fx:id="descriptionField" prefRowCount="4" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Observations" GridPane.rowIndex="1"/>
                <TextArea fx:id="observationsField" prefRowCount="4" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Cas Patient" GridPane.rowIndex="2"/>
                <TextField fx:id="casPatientField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Date" GridPane.rowIndex="3"/>
                <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button text="Enregistrer Consultation" onAction="#handleSave" styleClass="btn-success"/>
                <Button fx:id="ordonnanceButton" text="Créer Ordonnance" onAction="#handleOrdonnance" styleClass="btn-primary" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
