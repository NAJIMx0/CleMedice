<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.OrdonnanceController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Ordonnance" styleClass="top-bar-title"/>
            <Label fx:id="patientLabel" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 0 12;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label text="Cas Patient"/>
            <TextField fx:id="casPatientField"/>
            <Label text="Medicaments"/>
            <TableView fx:id="medicamentTable" prefHeight="200">
                <columns>
                    <TableColumn fx:id="nomCol" text="Medicament" prefWidth="200"/>
                    <TableColumn fx:id="dosageCol" text="Dosage" prefWidth="100"/>
                    <TableColumn fx:id="dureeCol" text="Duree" prefWidth="100"/>
                    <TableColumn fx:id="instrCol" text="Instructions" prefWidth="200"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Ajouter Medicament" onAction="#handleAddMedicament" styleClass="btn-secondary"/>
                <Button text="Retirer" onAction="#handleRemoveMedicament" styleClass="btn-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Enregistrer" onAction="#handleSave" styleClass="btn-success"/>
                <Button fx:id="printButton" text="Générer PDF" onAction="#handlePrint" styleClass="btn-primary" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
