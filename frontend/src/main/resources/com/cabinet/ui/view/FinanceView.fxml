<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.FinanceController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Finance" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exporter Excel" onAction="#handleExport" styleClass="btn-success"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding: 20;">
            <HBox spacing="16">
                <VBox styleClass="stat-card" prefWidth="220">
                    <Label styleClass="stat-label" text="Total ce mois"/>
                    <Label fx:id="totalMensuelLabel" styleClass="stat-value" text="0.00 MAD"/>
                </VBox>
                <VBox styleClass="stat-card" prefWidth="220">
                    <Label styleClass="stat-label" text="Total cette annee"/>
                    <Label fx:id="totalAnnuelLabel" styleClass="stat-value" text="0.00 MAD"/>
                </VBox>
                <VBox spacing="5" style="-fx-padding: 8 0 0 16;">
                    <Label text="Annee"/>
                    <TextField fx:id="anneeField" prefWidth="100"/>
                    <Label text="Mois"/>
                    <ComboBox fx:id="moisCombo" prefWidth="150"/>
                    <Button text="Actualiser" onAction="#handleRefresh" styleClass="btn-primary"/>
                </VBox>
            </HBox>
            <Label text="Paiements" styleClass="section-title"/>
            <TableView fx:id="paiementTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="patientCol" text="Patient" prefWidth="200"/>
                    <TableColumn fx:id="montantCol" text="Montant" prefWidth="100"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="110"/>
                    <TableColumn fx:id="modeCol" text="Mode" prefWidth="120"/>
                    <TableColumn fx:id="statutCol" text="Statut" prefWidth="90"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Ajouter Paiement" onAction="#handleAdd" styleClass="btn-success"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
