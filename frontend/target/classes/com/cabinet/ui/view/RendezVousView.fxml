<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.RendezVousController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Rendez-vous" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <DatePicker fx:id="datePicker" onAction="#handleDateFilter"/>
            <Button text="Aujourd'hui" onAction="#handleToday" styleClass="btn-primary"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="rdvTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="patientCol" text="Patient" prefWidth="180"/>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="110"/>
                <TableColumn fx:id="heureCol" text="Heure" prefWidth="80"/>
                <TableColumn fx:id="topicCol" text="Topic" prefWidth="200"/>
                <TableColumn fx:id="statutCol" text="Statut" prefWidth="110"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Nouveau RDV" onAction="#handleAdd" styleClass="btn-success"/>
            <Button text="Effectuer Consultation" onAction="#handleConsultation" styleClass="btn-primary"/>
            <Button text="Ajouter Paiement" onAction="#handleAddPayment" styleClass="btn-warning"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Annuler RDV" onAction="#handleCancel" styleClass="btn-danger"/>
        </HBox>
    </bottom>
</BorderPane>
