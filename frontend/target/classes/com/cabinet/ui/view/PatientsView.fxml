<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.PatientsController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Gestion des Patients" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="250"/>
            <Button text="Rechercher" onAction="#handleSearch" styleClass="btn-primary"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
                <TableColumn fx:id="prenomCol" text="Prenom" prefWidth="150"/>
                <TableColumn fx:id="cinCol" text="CIN" prefWidth="120"/>
                <TableColumn fx:id="telCol" text="Telephone" prefWidth="120"/>
                <TableColumn fx:id="dateCol" text="Date Naissance" prefWidth="120"/>
                <TableColumn fx:id="adresseCol" text="Adresse" prefWidth="200"/>
                <TableColumn text="Actions" prefWidth="200"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button text="Ajouter" onAction="#handleAdd" styleClass="btn-success"/>
            <Button text="Modifier" onAction="#handleEdit" styleClass="btn-primary"/>
            <Button text="Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
        </HBox>
    </bottom>
</BorderPane>
