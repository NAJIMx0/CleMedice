<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabinet.ui.controller.AttestationController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="&lt; Retour" onAction="#handleBack" styleClass="btn-secondary"/>
            <Label text="Attestation Medicale" styleClass="top-bar-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label text="Patient"/>
            <ComboBox fx:id="patientCombo" prefWidth="400" editable="true"/>
            <Label text="Contenu de l'attestation"/>
            <TextArea fx:id="contenuField" prefRowCount="6"/>
            <HBox spacing="10">
                <Button text="Générer PDF" onAction="#handleGenerate" styleClass="btn-primary"/>
                <Button text="Imprimer" onAction="#handlePrint" styleClass="btn-success"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
